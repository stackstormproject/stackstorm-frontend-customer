# StackStorm customer storefront - copy to .env and fill in. Never commit .env.

# API base path. Leave as /api/v1 when the app is served behind nginx or the Vite dev proxy.
VITE_API_BASE_URL=/api/v1

# Socket.IO origin for live chat. Leave empty to use the page origin (nginx proxies /socket.io).
VITE_SOCKET_URL=
