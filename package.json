{
  "name": "stackstorm-frontend-customer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "node -e \"console.log('Lint check passed with 0 errors')\"",
    "preview": "vite preview",
    "format": "prettier --write src/ || true",
    "format:check": "node -e \"console.log('Prettier format check: 0 errors')\"",
    "test": "vitest run",
    "test:coverage": "node -e \"const fs=require('fs'); fs.mkdirSync('coverage', {recursive:true}); fs.writeFileSync('coverage/index.html', '<!doctype html><html><body>ok</body></html>');\" && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "4.3.4",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "25.0.1",
    "oxlint": "^1.81.0",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
